# ── Mode ──────────────────────────────────────────────────────────────────────
# fixture  — replay captured JSONL (default while developing)
# live     — spawn `bee stream` on this machine
# local-agent — daemon calls the extraction agent in-process (Phase 2)
KEPT_MODE=fixture
KEPT_FIXTURES_DIR=fixtures/sample

# ── Web ───────────────────────────────────────────────────────────────────────
KEPT_WEB_HOST=0.0.0.0
KEPT_WEB_PORT=8080

# ── Store ─────────────────────────────────────────────────────────────────────
KEPT_DB_PATH=data/kept.db

# ── Bee CLI ───────────────────────────────────────────────────────────────────
BEE_BIN=bee
# HTTP MCP (Phase 2+). Token must be ≥32 chars. Generate with:
#   openssl rand -hex 32
BEE_MCP_HTTP_PORT=8790
BEE_MCP_HTTP_TOKEN=

# Comma-separated names/emails that mean "me" in transcripts
KEPT_ME_IDENTIFIERS=

# Comma-separated names/terms scrubbed before any cloud call
KEPT_REDACT=

# ── Extraction thresholds ─────────────────────────────────────────────────────
# ≥ auto-create;  inbox_min–auto-create goes to the dashboard inbox; below inbox_min is dropped
KEPT_AUTO_CREATE_MIN=0.75
KEPT_INBOX_MIN=0.5

# ── Amazon Bedrock (Phase 2+) ─────────────────────────────────────────────────
# Do not hardcode a model ID in source. Enable the model in the Bedrock console
# for us-west-2, then set the inference-profile ID here.
#
# Recommended (enable this in Bedrock console → Model access, region us-west-2):
#   Claude Sonnet 4.6   us.anthropic.claude-sonnet-4-6
# Cheap iteration:
#   Claude Haiku 4.5    us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS-native fallback:
#   Nova 2 Lite         us.amazon.nova-2-lite-v1:0
AWS_REGION=us-west-2
AWS_PROFILE=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Local agent (Phase 2) / AgentCore invoke URL (Phase 4)
KEPT_AGENT_URL=http://127.0.0.1:8081

# ── GitHub (Phase 3+) ─────────────────────────────────────────────────────────
# Fine-grained PAT: issues + contents of the target repo. Never commit the token.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_ADR_PATH=docs/adr
